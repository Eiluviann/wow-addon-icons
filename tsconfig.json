{
	// Hard-typing baseline. Pair with your bundler/runtime of choice.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		// "bundler" for Vite/esbuild/etc. Use "NodeNext" for plain Node ESM.
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"],

		// --- Strictness (the core of your profile) ---
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		// --- ESM discipline ---
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,

		// --- Output / DX ---
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist",

		// --- Plain JS with JSDoc (uncomment if a project is .js, not .ts) ---
		// "allowJs": true,
		// "checkJs": true
	},
	"include": ["src", "web", "vite.config.ts", "vitest.config.ts"],
	"exclude": ["node_modules", "dist", "web-dist"]
}
